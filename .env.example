# .env.example — copy to .env.local and fill in real values
# DO NOT put real credentials here. This file IS committed to git.
#
# IMPORTANT (Task 1 – Environment Security):
# All credentials below must be rotated before deploying to production.
# Any secret that existed in .env.local during development should be treated
# as potentially exposed and regenerated in the production environment.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ── Auth.js v5 ────────────────────────────────────────────────────────────────
AUTH_SECRET="replace-with-a-random-32+-char-string"
AUTH_URL="http://localhost:3000"

# ── Pusher (real-time) ────────────────────────────────────────────────────────
PUSHER_APP_ID=your-pusher-app-id
PUSHER_KEY=your-pusher-key
PUSHER_SECRET=your-pusher-secret
PUSHER_CLUSTER=ap1
NEXT_PUBLIC_PUSHER_KEY=your-pusher-key
NEXT_PUBLIC_PUSHER_CLUSTER=ap1

# ── Cron ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32

# ── Resend (email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_key_here
RESEND_FROM=noreply@yourdomain.com

# ── Mapbox ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Vercel / Deployment ───────────────────────────────────────────────────────
# VERCEL_URL is set automatically by Vercel; only override locally if needed.
# VERCEL_URL="https://your-project.vercel.app"
